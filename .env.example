# Copy to .env and adjust.  (docker-compose.yml reads this file)

GV_APP_NAME=BRAOU Gondi Vaani
GV_ENVIRONMENT=production

# Cookies are sent only over HTTPS. Keep true in production.
GV_COOKIE_SECURE=true
GV_SESSION_HOURS=8

# Allow the learner page to be embedded in Moodle (space-separated CSP sources).
# Example: GV_FRAME_ANCESTORS=self https://lms.braou.ac.in
GV_FRAME_ANCESTORS=self

# Upload limits
GV_MAX_AUDIO_BYTES=15728640
GV_MAX_AUDIO_SECONDS=120
GV_MAX_ZIP_BYTES=314572800

# Login protection
GV_LOGIN_MAX_FAILURES=5
GV_LOGIN_LOCKOUT_MINUTES=15

# Uvicorn worker processes
GV_WORKERS=2

# Local (non-Docker) development only:
# GV_ENVIRONMENT=development
# GV_COOKIE_SECURE=false
# GV_STORAGE_DIR=./storage
# GV_DATABASE_URL=sqlite:///./storage/gondi_vaani.db
